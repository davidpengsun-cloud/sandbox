{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/kge-portal/catalogue.v1.schema.json",
  "title": "Portal catalogue provider contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "release", "has_catalogue", "products"],
  "properties": {
    "contract_version": { "const": "1" },
    "release": { "type": "string", "minLength": 1 },
    "has_catalogue": { "type": "boolean" },
    "products": { "type": "array", "items": { "$ref": "#/$defs/product" } }
  },
  "$defs": {
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "rule", "rule_type"],
      "properties": {
        "dimension": { "type": "string" }, "rule": { "type": "string" }, "description": { "type": "string" },
        "rule_type": { "type": "string" }, "fail_percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "business_name", "quality", "terms", "data_type", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }, "business_name": { "type": "string" },
        "data_type": { "type": "string" }, "description": { "type": "string" },
        "quality": { "oneOf": [{ "$ref": "#/$defs/quality" }, { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/quality" } }] }, "terms": { "type": "array", "items": { "type": "string" } }, "classification": { "type": "string" }, "pii": { "type": "boolean" }
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false, "required": ["subscribe", "access", "views"],
      "properties": { "subscribe": { "type": "integer", "minimum": 0 }, "access": { "type": "integer", "minimum": 0 }, "views": { "type": "integer", "minimum": 0 } }
    },
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["origin_paths", "destination_paths", "upstream", "downstream"],
      "properties": {
        "origin_paths": { "type": "array", "items": { "type": "string" } }, "destination_paths": { "type": "array", "items": { "type": "string" } },
        "upstream": { "type": "array", "items": { "type": "string" } }, "downstream": { "type": "array", "items": { "type": "string" } }
      }
    },
    "product": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "unit_id", "table", "name", "description", "product_owner", "business_owner", "badges", "quality_score", "counts", "rating", "domain", "community", "application", "product_type", "lineage", "fields", "last_refresh", "ingested_at", "records", "path", "data_format", "storage", "last_dq_run"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "unit_id": { "type": "string", "minLength": 1 }, "table": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }, "product_owner": { "type": "string" }, "business_owner": { "type": "string" }, "product_owner_email": { "type": "string" }, "business_owner_email": { "type": "string" }, "steward": { "type": "string" }, "badges": { "type": "array", "items": { "type": "string" } },
        "quality_score": { "type": "number", "minimum": 0, "maximum": 100 }, "last_refresh": { "type": "string" }, "refresh_cadence": { "type": "string" }, "ingested_at": { "type": "string" },
        "counts": { "$ref": "#/$defs/counts" }, "rating": { "type": "number", "minimum": 0, "maximum": 5 },
        "domain": { "type": "string" }, "community": { "type": "string" }, "application": { "type": "string" }, "product_type": { "type": "string" },
        "asset_type": { "type": "string" }, "usage_purpose": { "type": "string" }, "dataset_type": { "type": "string" }, "APM_ID": { "type": "string" }, "schema": { "type": "string" }, "project": { "type": "string" },
        "records": { "type": ["integer", "null"], "minimum": 0 }, "path": { "type": "string" }, "data_format": { "type": "string" }, "storage": { "type": "string" }, "last_dq_run": { "type": "string" },
        "lineage": { "$ref": "#/$defs/lineage" }, "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }
      }
    }
  }
}
