# Copy to .env beside compose.yaml, then set SESSION_SECRET and PORTAL_SYNC_TOKEN to separate 48-character random values.
CLIENT=meridian
KGE_PORT=8000
PORTAL_PORT=8090
GCS_PORT=4443
SESSION_SECRET=
# Shared sign-outs and personal tokens use the store; Compose uses this default and does not pass this setting.
SESSION_STATE_BACKEND=store
PORTAL_SYNC_TOKEN=
PORTAL_ASK=on
# kge, portal or none: start of kge -> portal -> none; empty: kge with KGE_URL, portal otherwise.
PORTAL_ASK_PROVIDER=
# Portal catalogue agent model id; empty: rules only, no model call.
PORTAL_ASK_MODEL=
# vertex, or mock for offline tests; only used with PORTAL_ASK_MODEL.
PORTAL_ASK_MODEL_PROVIDER=vertex

# Client name for the portal and KGE product <client> ALTA; unset or blank uses Client. Independent of CLIENT, the profile id.
# Compose passes this one value to the portal and to the app as CLIENT_NAME.
PORTAL_CLIENT_NAME=Client
# Product short name and long form; trimmed, unset or blank uses these ALTA values.
# Compose passes the short name to the portal and to the app as PRODUCT_NAME.
PORTAL_PRODUCT_NAME=ALTA
PORTAL_PRODUCT_LONG_NAME=ALTA: AI-powered Library for Trusted Assets
PORTAL_PRODUCT_SUBTITLE=Search curated data assets, see how fresh and trustworthy each one is, and request access from the people who own it.
# Context Ask header's title and subtitle; trimmed, unset or blank uses these values.
PORTAL_CONTEXT_ASK_TITLE=Ask a governed question
PORTAL_CONTEXT_ASK_SUBTITLE=Certified definitions and figures, answered only from data you may read.
PORTAL_LOGO_TITLE=off

# Runtime app flags: on or off; with the ALTA home off, exactly one app must be on.
# home, home link and app switcher; Docs entry hidden for now
PORTAL_KNOWLEDGE_HOME=on
# Certify stub and link out to the Power App
PORTAL_APP_CERTIFY=on
# Context inside the portal; requires KGE_URL
PORTAL_APP_CONTEXT=on
# Discover browsing, search and access requests
PORTAL_APP_DISCOVER=on
# Cerebro inside the portal: chat, graph and curation; requires KGE_URL
PORTAL_APP_CEREBRO=on
# Cerebro's display name; trimmed, unset or blank uses Cerebro; Graph keeps the earlier default
PORTAL_CEREBRO_NAME=Cerebro
# Run Query on table pages and its server endpoint; on or off, default off; read at portal startup.
PORTAL_TABLE_QUERY=off
# Preview on table pages, its endpoints and CSV exports; on or off, default off; read at portal startup.
PORTAL_TABLE_PREVIEW=off
# Data quality filter buttons; on or off, default on. off shows All with no filter buttons.
PORTAL_DQ_FILTERS=on
# Discover's Ask Guidelines section; on or off, default on. Any other value stops the portal at start, naming the setting.
PORTAL_ASK_GUIDE=on
# external http or https address; empty shows [Power App link]
PORTAL_CERTIFY_URL=

# Traces of the app and the portal: off (default), console (each span to the container's standard error) or otlp (to
# TRACING_ENDPOINT, OTLP over HTTP). Spans carry names, ids, timings, counts, sizes and outcomes only, never a question,
# SQL, values, names, emails, prompts or replies. cloudtrace is for Cloud Run alone.
TRACING=off
# The OTLP/HTTP traces address for otlp; empty: http://localhost:4318/v1/traces, which inside a container is the
# container itself, so name a collector the containers can reach.
TRACING_ENDPOINT=
# The origins the portal sends a question's trace context to (the traceparent alone, never tracestate or baggage), so
# that with tracing on a question is one trace. Unset: the portal's KGE_URL, KGE alone. Set it empty to send it nowhere;
# list another origin only on purpose. KGE itself is given none, so no model provider, BigQuery or other third party
# is ever sent one.
# TRACE_PROPAGATE_TO=
