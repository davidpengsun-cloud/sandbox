# Copy to .env beside compose.yaml, then set SESSION_SECRET and PORTAL_SYNC_TOKEN to separate 48-character random values.
CLIENT=meridian
KGE_PORT=8000
PORTAL_PORT=8090
GCS_PORT=4443
SESSION_SECRET=
PORTAL_SYNC_TOKEN=
PORTAL_ASK=on

# Client name for the portal and KGE product <client> ALTA; unset or blank uses Client. Independent of CLIENT, the profile id.
# Compose passes this one value to the portal and to the app as CLIENT_NAME.
PORTAL_CLIENT_NAME=Client
# Product short name and long form; trimmed, unset or blank uses these ALTA values.
# Compose passes the short name to the portal and to the app as PRODUCT_NAME.
PORTAL_PRODUCT_NAME=ALTA
PORTAL_PRODUCT_LONG_NAME=ALTA: AI-powered Library for Trusted Assets
PORTAL_PRODUCT_SUBTITLE=Search curated data assets, see how fresh and trustworthy each one is, and request access from the people who own it.
PORTAL_LOGO_TITLE=off

# Runtime app flags: on or off; with the ALTA home off, exactly one app must be on.
# home, home link and app switcher; Docs entry hidden for now
PORTAL_KNOWLEDGE_HOME=on
# Certify stub and link out to the Power App
PORTAL_APP_CERTIFY=on
# Context inside the portal; requires KGE_URL
PORTAL_APP_CONTEXT=on
# Discover browsing, search and access requests
PORTAL_APP_DISCOVER=on
# Run Query on table pages and its server endpoint; on or off, default off; read at portal startup.
PORTAL_TABLE_QUERY=off
# Preview on table pages, its endpoints and CSV exports; on or off, default off; read at portal startup.
PORTAL_TABLE_PREVIEW=off
# external http or https address; empty shows [Power App link]
PORTAL_CERTIFY_URL=

# The portal owns Context at /context. Enable the standalone page only as a fallback.
CONTEXT_PAGE=off
