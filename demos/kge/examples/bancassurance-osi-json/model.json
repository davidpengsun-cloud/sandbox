{
  "version": "0.2.0.dev0",
  "name": "bancassurance",
  "description": "Bancassurance policies and written premiums.",
  "datasets": [
    {"name": "policyholder", "source": "insurance.policyholder", "primary_key": ["policyholder_id"], "fields": [
      {"name": "policyholder_id", "datatype": "Integer", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "policyholder_id"}]}},
      {"name": "name", "datatype": "String", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "name"}]}}
    ]},
    {"name": "policy", "source": "insurance.policy", "primary_key": ["policy_id"], "fields": [
      {"name": "policy_id", "datatype": "Integer", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "policy_id"}]}},
      {"name": "policyholder_id", "datatype": "Integer", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "policyholder_id"}]}}
    ]},
    {"name": "premium", "source": "insurance.premium", "primary_key": ["premium_id"], "fields": [
      {"name": "premium_id", "datatype": "Integer", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "premium_id"}]}},
      {"name": "policy_id", "datatype": "Integer", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "policy_id"}]}},
      {"name": "written_on", "datatype": "Date", "dimension": {"is_time": true}, "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "written_on"}]}},
      {"name": "premium_amount", "datatype": "Decimal", "description": "Premium written before cancellations.", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "premium_amount"}]}}
    ]}
  ],
  "relationships": [
    {"name": "policy_to_policyholder", "from": "policy", "to": "policyholder", "from_columns": ["policyholder_id"], "to_columns": ["policyholder_id"]},
    {"name": "premium_to_policy", "from": "premium", "to": "policy", "from_columns": ["policy_id"], "to_columns": ["policy_id"]}
  ],
  "metrics": [
    {"name": "written_premium", "description": "Premium written through the bancassurance channel.", "datatype": "Decimal", "ai_context": {"currency": "GBP", "period_column": "written_on", "synonyms": ["gross written premium"]}, "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "SUM(premium.premium_amount)"}]}},
    {"name": "loss_ratio", "datatype": "Decimal", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "SUM(premium.premium_amount) / 2"}]}}
  ]
}
