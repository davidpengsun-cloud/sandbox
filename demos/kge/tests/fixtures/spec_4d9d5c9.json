 "GLOSSARY": [
  {
   "term": "Revenue",
   "domain": "Finance",
   "steward": "Group Finance Data Steward",
   "definition": "Income earned from customers in a period, before costs. Each business unit reports it at its own grain, currency and calendar; see the implementation metadata."
  },
  {
   "term": "Net Interest Income",
   "domain": "Finance",
   "steward": "Group Finance Data Steward",
   "definition": "Interest earned less interest paid, in the reporting currency, for the period."
  },
  {
   "term": "Fee Income",
   "domain": "Finance",
   "steward": "Group Finance Data Steward",
   "definition": "Fees and commissions charged to customers in the period."
  },
  {
   "term": "Active Customer",
   "domain": "Customer",
   "steward": "Customer Data Steward",
   "definition": "A customer with at least one customer-initiated transaction in the calendar month. Logins alone do not count. Version 2, effective 1 January 2025."
  },
  {
   "term": "Assets Under Advice",
   "domain": "Wealth",
   "steward": "Wealth Data Steward",
   "definition": "Market value of client assets on which the firm gives advice, at quarter end, USD."
  },
  {
   "term": "Credit Exposure",
   "domain": "Risk",
   "steward": "Credit Risk Data Steward",
   "definition": "Exposure at default to a counterparty at the measurement date."
  },
  {
   "term": "Delinquency Rate",
   "domain": "Risk",
   "steward": "Credit Risk Data Steward",
   "definition": "Share of scheduled repayments more than 30 days past due in the month."
  },
  {
   "term": "Customer Attrition",
   "domain": "Customer",
   "steward": "Customer Data Steward",
   "definition": "Customers whose last account closed in the month, as a share of opening customers."
  },
  {
   "term": "Average Balance",
   "domain": "Finance",
   "steward": "Group Finance Data Steward",
   "definition": "Mean end-of-day ledger balance over the calendar month."
  },
  {
   "term": "Dormant Account",
   "domain": "Customer",
   "steward": "Customer Data Steward",
   "definition": "An open account with no customer-initiated transaction for twelve months."
  },
  {
   "term": "Limit Utilisation",
   "domain": "Risk",
   "steward": "Credit Risk Data Steward",
   "definition": "Utilised amount as a share of the approved limit at the measurement date."
  },
  {
   "term": "Covenant Breach",
   "domain": "Risk",
   "steward": "Credit Risk Data Steward",
   "definition": "A covenant whose most recent test failed its threshold."
  },
  {
   "term": "Suitability Review",
   "domain": "Wealth",
   "steward": "Wealth Data Steward",
   "definition": "A documented review of whether a household's portfolio remains suitable."
  },
  {
   "term": "Complaint",
   "domain": "Conduct",
   "steward": "Conduct Data Steward",
   "definition": "An expression of dissatisfaction recorded under the complaints handling procedure."
  },
  {
   "term": "Notional",
   "domain": "Markets",
   "steward": "Markets Data Steward",
   "definition": "Face value of a derivative or loan deal, in deal currency."
  },
  {
   "term": "Probability of Default",
   "domain": "Risk",
   "steward": "Credit Risk Data Steward",
   "definition": "Twelve-month probability of default, in basis points."
  },
  {
   "term": "Loss Given Default",
   "domain": "Risk",
   "steward": "Credit Risk Data Steward",
   "definition": "Expected loss as a share of exposure if the counterparty defaults."
  },
  {
   "term": "Internal Rating",
   "domain": "Risk",
   "steward": "Credit Risk Data Steward",
   "definition": "The bank's own credit grade for a counterparty."
  },
  {
   "term": "Household",
   "domain": "Wealth",
   "steward": "Wealth Data Steward",
   "definition": "The unit of advice in wealth management: one or more related clients advised together."
  },
  {
   "term": "Relationship Manager",
   "domain": "Customer",
   "steward": "Customer Data Steward",
   "definition": "The named individual accountable for an SME client relationship."
  },
  {
   "term": "Fiscal Year",
   "domain": "Finance",
   "steward": "Group Finance Data Steward",
   "definition": "The twelve months from 1 April, used by Corporate and Wealth. Retail and SME report on the calendar year."
  },
  {
   "term": "Period-End FX Rate",
   "domain": "Finance",
   "steward": "Group Finance Data Steward",
   "definition": "The exchange rate on the last day of the period, used to convert Corporate revenue to USD."
  },
  {
   "term": "Product Holding",
   "domain": "Customer",
   "steward": "Customer Data Steward",
   "definition": "Count of distinct open products held by a customer."
  },
  {
   "term": "New-to-Bank Customer",
   "domain": "Customer",
   "steward": "Customer Data Steward",
   "definition": "A customer whose first account opened in the month."
  },
  {
   "term": "Market Value",
   "domain": "Wealth",
   "steward": "Wealth Data Steward",
   "definition": "Value of a holding at the valuation date in portfolio base currency."
  },
  {
   "term": "Digital Login",
   "domain": "Customer",
   "steward": "Customer Data Steward",
   "definition": "An authenticated session on the mobile or online channel."
  },
  {
   "term": "Branch",
   "domain": "Distribution",
   "steward": "Distribution Data Steward",
   "definition": "A physical retail location."
  },
  {
   "term": "Segment",
   "domain": "Customer",
   "steward": "Customer Data Steward",
   "definition": "Marketing segment assigned to a retail customer."
  },
  {
   "term": "Facility",
   "domain": "Lending",
   "steward": "Credit Risk Data Steward",
   "definition": "A committed or uncommitted lending line to an SME client."
  },
  {
   "term": "Drawdown",
   "domain": "Lending",
   "steward": "Credit Risk Data Steward",
   "definition": "A utilisation of a facility."
  },
  {
   "term": "Counterparty",
   "domain": "Markets",
   "steward": "Markets Data Steward",
   "definition": "A legal entity with which the bank transacts in Corporate & Institutional."
  },
  {
   "term": "Legal Entity Identifier",
   "domain": "Markets",
   "steward": "Markets Data Steward",
   "definition": "The 20-character identifier for a counterparty under the global LEI system."
  },
  {
   "term": "Risk Profile",
   "domain": "Wealth",
   "steward": "Wealth Data Steward",
   "definition": "The household's agreed appetite for investment risk."
  },
  {
   "term": "Mandate",
   "domain": "Wealth",
   "steward": "Wealth Data Steward",
   "definition": "Whether the firm manages a portfolio at its discretion or advises only."
  },
  {
   "term": "Channel",
   "domain": "Distribution",
   "steward": "Distribution Data Steward",
   "definition": "The route by which a transaction was initiated."
  },
  {
   "term": "Merchant Category",
   "domain": "Payments",
   "steward": "Payments Data Steward",
   "definition": "The card-scheme category of a merchant."
  },
  {
   "term": "Resolved Complaint",
   "domain": "Conduct",
   "steward": "Conduct Data Steward",
   "definition": "A complaint with a recorded resolution date."
  },
  {
   "term": "Open Account",
   "domain": "Customer",
   "steward": "Customer Data Steward",
   "definition": "An account whose status is OPEN at the reference date."
  },
  {
   "term": "Days Past Due",
   "domain": "Risk",
   "steward": "Credit Risk Data Steward",
   "definition": "Days elapsed since a scheduled repayment date without payment."
  },
  {
   "term": "Sector",
   "domain": "Markets",
   "steward": "Markets Data Steward",
   "definition": "Industry sector of a counterparty."
  }
 ],
