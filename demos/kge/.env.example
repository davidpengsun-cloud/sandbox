# Optional. Copy to .env beside this file; the pipeline, the eval and the API
# load it on start, and a variable already set in the environment wins.
# Without a key the pipeline uses the rule-based tagger and the assistant
# answers from the graph alone, which is enough for the walkthrough.
MODEL_PROVIDER=none          # none | gemini | anthropic | openai | ollama | vertex-claude | vertex-gemini; one model for the tagger and the assistant. mock: the offline stand-in for the reference agent only
MODEL_NAME=                  # the provider's model. vertex-claude: claude-haiku-5-5 unless set. vertex-gemini: needed, the Flash-Lite model as Vertex AI names it, e.g. gemini-2.5-flash-lite
MODEL_API_KEY=               # not read by vertex-claude or vertex-gemini: they sign in as the runtime's service account (application default credentials)
MODEL_BASE_URL=              # optional. gemini: the Vertex AI publisher path (MODEL_API_KEY is then an access token). Others: an OpenAI-compatible endpoint; ollama defaults to http://localhost:11434/v1
VERTEX_REGION=               # vertex-claude and vertex-gemini: the Vertex AI location, e.g. us-east5. Empty: global
VERTEX_PROJECT=              # vertex-claude and vertex-gemini: the Google Cloud project. Empty: the one the service account's credentials name
MODEL_SEED=7                 # sent with every model call where the provider takes a seed (gemini, vertex-gemini, openai, ollama); recorded in each run trace
MODEL_PRICE_IN=               # optional. The model's price, USD per million tokens in and out; the A/B report (make ab) costs runs at it, unknown if unset
MODEL_PRICE_OUT=
MODEL_MAX_TOKENS=             # optional. Image default: 8192 tokens, including thinking. Overrides every caller's budget except the fixed 256-token connectivity probe
MODEL_REQUEST_TIMEOUT=       # optional. Image default: 270 seconds for the whole /ask request (HTTP or MCP), including model calls and graph and warehouse queries; must be below 300
MODEL_TOTAL_TIMEOUT=         # optional. Image default: 270 seconds for attempt plus retry; must be below 300
MODEL_TIMEOUT=               # optional. Image default: 180 seconds per attempt; capped at the remaining total budget
MODEL_HIGH_PROVIDER=        # optional high tier; blank falls back to MODEL_PROVIDER and MODEL_NAME together; none turns the tier's model off; an unknown name is refused
MODEL_HIGH_NAME=            # needed with a tier's provider (vertex-claude excepted): a tier is a provider and its model together
MODEL_HIGH_API_KEY=         # the tier's own key and endpoint; blank uses MODEL_API_KEY and MODEL_BASE_URL only when the tier's provider is MODEL_PROVIDER, else none
MODEL_HIGH_BASE_URL=
MODEL_HIGH_PRICE_IN=
MODEL_HIGH_PRICE_OUT=
MODEL_HIGH_MAX_TOKENS=        # optional. Image default: MODEL_MAX_TOKENS, else 8192. The tier's reply budget; wins over MODEL_MAX_TOKENS for the tier's model. Ignored while the tier has no provider
MODEL_MEDIUM_PROVIDER=      # optional medium tier; blank falls back to the default model
MODEL_MEDIUM_NAME=
MODEL_MEDIUM_API_KEY=
MODEL_MEDIUM_BASE_URL=
MODEL_MEDIUM_PRICE_IN=
MODEL_MEDIUM_PRICE_OUT=
MODEL_MEDIUM_MAX_TOKENS=      # optional. MODEL_MAX_TOKENS, else the image default of 8192
MODEL_LOW_PROVIDER=         # optional low tier; blank falls back to the default model
MODEL_LOW_NAME=
MODEL_LOW_API_KEY=
MODEL_LOW_BASE_URL=
MODEL_LOW_PRICE_IN=
MODEL_LOW_PRICE_OUT=
MODEL_LOW_MAX_TOKENS=         # optional. MODEL_MAX_TOKENS, else the image default of 8192
# A tier set while MODEL_PROVIDER is none turns on the model path of each agent that takes it (its *_MODEL_TIER, or
# the tier it prefers), the tagger's included; with no tier set, every agent stays where it was
ONBOARD_MODEL_TIER=         # high | medium | low | default; blank prefers high when configured
ONBOARD_MODEL_RETRIES=      # 0 to 5; blank is 2. How often onboarding's drafting steps send a refused reply back to the model before rules
ENHANCE_MODEL_TIER=         # high | medium | low | default; blank prefers high when configured
ANSWER_MODEL_TIER=          # high | medium | low | default; blank prefers medium when configured
CONTEXT_MODEL_TIER=         # high | medium | low | default; blank prefers high, then medium, then default (medium or better); never automatically low
READER_MODEL_TIER=          # high | medium | low | default; blank prefers medium when configured
ASSIST_MODEL_TIER=          # high | medium | low | default; blank prefers high, then medium, then default (medium or better); never automatically low
TAGGER_MODEL_TIER=          # high | medium | low | default; blank prefers low when configured. A provider named in TAGGER_PROVIDER wins over any tier
MOCK_MODE=careful            # with MODEL_PROVIDER=mock: careful, or an adversary the agent's seam must catch (see the README). The mock ignores MODEL_NAME
EVAL_CONCURRENCY=8           # how many questions make ab, make margin (onboard's post-load check), make eval, make parity and test-drive ask at once; a positive whole number, else refused. 1 asks one at a time
CONTEXT_URL=                 # the context service the reference agent gets its context from, as a downstream app does: POST /context there with the asker's own token, e.g. http://127.0.0.1:8000. Empty: in its own process, through the API's route, token check and JSON
PROFILE=                     # the profile this deployment serves, an id in the profiles registry: its client and where its things are. Empty: the registry's default
PROFILES=                    # the profiles registry. Empty: deploy/profiles.yaml
EMBEDDING_PROVIDER=hash      # hash | local (local needs: pip install sentence-transformers) | vertex (Vertex AI text-embedding API)
EMBEDDING_MODEL=             # with EMBEDDING_PROVIDER=vertex: model name; blank: gemini-embedding-001 (text-embedding-004 is retired)
WAREHOUSE_BACKEND=           # duckdb (default) | bigquery: BigQuery datasets with dryRun gating; the estate, certification and onboarding make, load and read the warehouses there (<prefix>_<client>_warehouses), and no DuckDB file is made
APP_STATE_BACKEND=           # files (default) | bigquery: transactional onboarding state in the graph dataset
RETRIEVAL_BACKEND=           # ladybug (default) | bigquery: BigQuery VECTOR_SEARCH over chunks table
GRAPH_STORE=                 # ladybug (default) | bigquery: the graph's node and edge tables and property graph in <prefix>_<client>_graph, queried with GQL in GRAPH_TABLE; the graph store's folder then keeps graph.bigquery, a pointer, and no Ladybug file. The local stack's checks run on ladybug
LADYBUG_MAX_DB_MB=128        # maximum size in MB of every Ladybug database, on disk or in memory. A positive whole number; raise it only for a graph over 128 MB
DATA_EXPORT_ROW_CAP=10000    # maximum rows returned by one governed data export; a positive whole number
BIGQUERY_PROJECT=            # Google Cloud project for BigQuery warehouses and graph datasets. Empty: VERTEX_PROJECT or ADC default
BIGQUERY_DATASET_PREFIX=kge  # Dataset prefix (default: kge). Creates <prefix>_<client>_warehouses and <prefix>_<client>_graph
BIGQUERY_LOAD_INLINE_MAX=    # bytes: a BigQuery load whose newline-delimited JSON is larger is staged as a file in the scratch area (TMP_URL) and loaded from gs://; at most this, or where the scratch area is a local folder, it is sent inline. Empty: 5242880 (5 MiB), a planning default. A whole number above 0, else refused
BIGQUERY_MAX_BYTES_BILLED=   # bytes: optional maximumBytesBilled cap per BigQuery query job; a positive whole number above 0, else refused
BIGQUERY_JOB_TIMEOUT=        # seconds: optional BigQuery query and load job timeout (default 300 synchronous, 600 background); a positive number, else refused
DEFAULT_RUNTIMES=            # optional comma-separated ordered list of runtime ids (e.g. bq_live,reference); blank uses the pack's default_runtimes, else ["reference"]
PAST_QUESTIONS_RETENTION_DAYS=30 # retention window in days for Context Ask per-person question and conversation history; 0 disables retention
SUITE=                       # eval job input: path or gs:// URL to a custom or templated UAT question suite JSON file
ARM=                         # eval job input: preset or agent arm (schema, catalog, graph, control, treatment, or all)
RUNTIMES=                    # eval job input: optional comma-separated ordered list of runtime ids to evaluate against
PRINCIPAL=                   # sign-off, eval, agent, ab: acting or querying principal
TAGGER_PROVIDER=rules        # rules (default) | model: rule-based or LLM tagging during onboarding; a provider other than MODEL_PROVIDER needs the three below
TAGGER_NAME=                 # that provider's model (vertex-claude excepted); MODEL_NAME is MODEL_PROVIDER's
TAGGER_API_KEY=              # that provider's key; MODEL_API_KEY is never sent to another provider
TAGGER_BASE_URL=
CLIENT_NAME=Client           # KGE product <client> ALTA: trimmed; unset or blank uses Client. Compose supplies PORTAL_CLIENT_NAME; Terraform supplies portal_client_name
PRODUCT_NAME=ALTA            # KGE product short name, as in <client> ALTA: trimmed; unset or blank uses ALTA. Compose supplies PORTAL_PRODUCT_NAME; Terraform supplies portal_product_name
CONTEXT_APP_NAME=Context    # developer landing page app name; trimmed; unset or blank uses Context
RUN_JOB=                   # onboarding job name; unset or blank uses the Cloud Run service name (K_SERVICE)
SIGNIN=                      # passwords: the pilot's sign-in, a username and password per person (make passwords), sessions that survive a restart. Empty: the demo's, a token (or a name with DEMO_MODE=1, on this machine only)
SESSION_SECRET=              # with SIGNIN=passwords: the key sessions are signed with, 32 characters or more, from the deployment's secret store. Empty: one made in the run state. Never commit one
SESSION_STATE_BACKEND=store  # where signed-out sessions and personal tokens are shared by every API instance: store (the store bucket, or a local folder) or bigquery
PORTAL_SYNC_TOKEN=           # off Cloud Run: shared by KGE and the discovery portal for whole-catalogue sync, 32 characters or more. Empty: the internal route refuses unless it verifies the portal's Google identity token
SIGNIN_PASSWORDS=            # with SIGNIN=passwords: the hashed passwords, passwords.json as make passwords wrote it, from the deployment's secret store. Empty: the run state's passwords.json
ACCESS_ADMINS=               # readable comma-separated bootstrap admin emails, unioned with stored admins; access ADMINS=... writes the reserved admin role through the operator job only; the API never grants admin
TRUSTED_CALLER_EMAIL=        # with TRUSTED_CALLER_AUDIENCE: the service account whose Google ID token (X-Caller-Token, for TRUSTED_CALLER_AUDIENCE) lets a caller name the address a sign-in is counted against (X-Client-Address): the discovery portal's on the pilot, from Terraform. Empty, with TRUSTED_CALLER_AUDIENCE: every sign-in counts its caller's own address. One without the other stops the API
TRUSTED_CALLER_AUDIENCE=     # with TRUSTED_CALLER_EMAIL: the page's own address, the audience that ID token must name
STORE_URL=                   # the object store it keeps clients/, deploy/, the job's work and the releases in (kge/adapters/objstore/): /abs/path, file:///abs/path or gs://bucket[/prefix]. The service also reads it for the access store. Empty: local access store
LANDING_URL=                 # with STORE_URL: the client's landing, a store URL. Empty: <STORE_URL>/landing/<client>
STORAGE_EMULATOR_HOST=       # with a gs:// store: a GCS emulator's address, e.g. http://127.0.0.1:4443, called with no credentials. Empty: Google Cloud Storage, as the runtime's service account
TMP_URL=                     # the client's scratch area, for files a step stages and then deletes: the store URL of the tmp bucket, gs://<project>-kge-tmp on the pilot (Terraform sets it), the area tmp/<client>/ in it. Empty: kge-tmp/<client>/ in this machine's temporary folder, as the local stack and Compose use
KGE_VERSION=dev              # image version shown by /healthz and the page; the kit build sets this
KGE_LOGO=                    # the client's logo for the page's bar: a path to an svg, png, jpg, jpeg or ico image of 256 KB or less (a plain-drawing SVG: no doctype, script, event handler, animation, style sheet, embedded image, character reference or external link), served at /brand/logo; a bad one stops the API, naming the setting. Empty: the portal's logo when PORTAL_URL names a portal configured with one (PORTAL_LOGO), else the client's name. Set one of KGE_LOGO and PORTAL_LOGO; when joined, KGE takes the portal's
PORTAL_URL=                  # the portal's http or https address: the developer page and role guides link to it; with no KGE_LOGO the API asks it for its logo as it starts
API_URL=                     # address the API names for its own in-process calls; make serve sets it
SERVE_HASH=                  # optional artifact hash to preview instead of the current release
CLOUD_RUN_API=               # optional Cloud Run API base URL; empty uses Google's public endpoint
K_SERVICE=                   # Cloud Run service name, supplied by Cloud Run
RUN_REGION=                  # Cloud Run region, supplied by Terraform
VERTEX_EMBEDDING_MODEL=      # optional Vertex embedding model; EMBEDDING_MODEL is the portable name
VERTEX_EMBEDDING_REGION=     # optional Vertex embedding location; empty: VERTEX_REGION, then global
EMBEDDING_DIM=               # with EMBEDDING_PROVIDER=vertex: the vector's width. Blank: 768 where retrieval is BigQuery's (RETRIEVAL_BACKEND, else WAREHOUSE_BACKEND, bigquery), 128 otherwise; any width but 128 is refused there. hash and local are always 128
CLIENT=                      # setup-client command input
EXAMPLE=                     # put-example command input
FROM=                        # put-example source folder; onboard: absolute folder locally, or a fresh <STORE_URL>/uploads/<client>/<id>/ URL with a store. Empty: use stored inputs
HASH=                        # release command artifact hash
GRAPH_DATASET=               # graph (default) | candidates: which BigQuery dataset a process writes graphs and chunk tables to; the improvement job's candidate steps set candidates themselves, a dataset nothing serves

# Portal-alone authentication; ignored when KGE_URL is set. Keep credential files outside source control.
PORTAL_IDENTITIES_FILE=      # absolute path to KGE-format principals.json (principal, role, reads, processes)
PORTAL_PASSWORDS_FILE=       # absolute path to KGE-format passwords.json: principal -> salted scrypt hash
PORTAL_SESSION_SECRET=       # standalone only: required, at least 32 random characters
PORTAL_COOKIE_SECURE=true    # true by default; false only for local HTTP
PORTAL_CATALOGUE_FILE=       # standalone catalogue.yaml file; make portal resolves a relative path
PORTAL_CATALOGUE_PROVIDER=   # kge or file; inferred from KGE_URL or PORTAL_CATALOGUE_FILE when empty

NAME=                       # optional test-drive display name; unset: title-cased client id (Meridian keeps its sample name)
PORTAL_SEARCH_PROVIDER=      # kge when KGE_URL is configured, portal otherwise; portal uses its own tables
PORTAL_ASK=on                # on or off; off clears /brand's legacy kge_url field. GlobalBar ignores it; Ask buttons, panels and routes stay available. Use PORTAL_APP_CONTEXT, PORTAL_APP_CERTIFY or PORTAL_APP_DISCOVER to hide an app. Any other value stops startup, naming the setting
PORTAL_ASK_PROVIDER=         # kge, portal or none: start of kge -> portal -> none; unset: kge with KGE_URL, portal otherwise
PORTAL_ASK_MODEL=            # portal catalogue agent model id; unset: rules only, no model call
PORTAL_ASK_MODEL_PROVIDER=vertex # vertex or mock (offline tests); used only with PORTAL_ASK_MODEL
PORTAL_DATA_PROVIDER=        # kge with a KGE client, none otherwise; preview/export/query only
PORTAL_KGE_TIMEOUT=30        # seconds for identity, session, catalogue and data requests; whole number 1-299
PORTAL_SEARCH_TIMEOUT=30     # seconds for KGE Search; whole number 1-299
PORTAL_ASK_TIMEOUT=285       # seconds for KGE Ask; above KGE's model-call total MODEL_TOTAL_TIMEOUT (270 s by default), below Cloud Run's 300; whole number 1-299
# Set to the address people reach KGE at. With KGE_URL set, /api/config's contextMcpUrl
# appends /mcp to this address (empty: KGE_URL), removing trailing slashes first.
# Context's MCP help shows it. With PORTAL_APP_CONTEXT=on, KGE_URL marks Context set up
# even if KGE_PUBLIC_URL is empty; KGE_PUBLIC_URL alone does not set up Context.
# Empty on Compose gives http://app:8000/mcp, unreachable by a browser or agent outside Compose.
# contextMcpUrl is null without KGE_URL or with PORTAL_APP_CONTEXT=off; PORTAL_ASK=off does not affect it.
KGE_PUBLIC_URL=              # also supplies /brand's legacy kge_url, ignored by GlobalBar; that field is null without KGE_URL or with PORTAL_ASK=off

SEARCH_PASSAGE_MIN_SIMILARITY=0.2 # search discovery floor on raw passage similarity, 0–1; zero-score hits always excluded

# Job command inputs; unset keeps current state unless the command says otherwise.
# Leave ASKER and BASELINE unset to keep them; explicitly empty clears them.
# ASKER=                     # setup-client: querying principal; unset keeps the current asker
# BASELINE=                  # setup-client: baseline path; unset keeps it, empty clears it; baseline job: empty records without comparison
CLOUD_RUN_TASK_ATTEMPT=0     # supplied by Cloud Run: whole number at least 0. Writers refuse attempts above 0; unset is the first attempt
CONFIRM=                    # teardown requires this install's client id; empty refuses
PEOPLE=                     # setup-client: principal:role bindings; teardown: remove deletes the deployment and profile; empty keeps them
PREVIEW=                    # teardown: yes lists what would be removed without changing it; empty removes after CONFIRM
PREVIOUS=                   # release: yes restores the previous release; empty releases the candidate
ROTATE=                     # passwords: all rotates every person; empty keeps earlier hashes and adds only new people
ADMINS=                     # access job only: replace stored Access admins; BY identifies the operator
GRANT=                      # access: username:role[,role]; empty makes no grant
REVOKE=                     # access: username to remove; empty removes nobody
LIST=                       # access: yes lists people and reports out-of-band changes; empty does not list
AUDIT=                      # access: yes lists the access audit; empty does not list
MIGRATE=                    # access: yes imports deployment identities once; empty does not migrate
EMAILS=                     # access migration: space-separated principal=email mappings; empty keeps principal ids as usernames
BY=                         # access writes: an admin username from ACCESS_ADMINS or the stored admin grants; empty refuses a write

PORTAL_CLIENT_NAME=Client    # client display name: trimmed; unset or blank uses Client. Names the product <client> ALTA, its audience and KGE pages; independent of PROFILE
PORTAL_PRODUCT_NAME=ALTA     # product short name: trimmed; unset or blank uses ALTA. Names <client> ALTA, ALTA home, ALTA docs and Ask ALTA, and KGE pages
PORTAL_PRODUCT_LONG_NAME=ALTA: AI-powered Library for Trusted Assets  # product long form: trimmed; unset or blank uses the ALTA value shown. Shown on the sign-in tile, admin page and table pages
PORTAL_PRODUCT_SUBTITLE=Search curated data assets, see how fresh and trustworthy each one is, and request access from the people who own it.
# Context Ask header's title and subtitle; trimmed, unset or blank uses these values. Read when the portal starts.
PORTAL_CONTEXT_ASK_TITLE=Ask a governed question
PORTAL_CONTEXT_ASK_SUBTITLE=Certified definitions and figures, answered only from data you may read.
PORTAL_LOGO_TITLE=off        # on shows the product name beside a configured logo; off hides it. With no logo the name stays visible.

# Runtime app flags: on or off; with the ALTA home off, exactly one app must be on.
PORTAL_KNOWLEDGE_HOME=on      # home, home link and app switcher; Docs entry hidden for now
PORTAL_APP_CERTIFY=on        # Certify stub and link out to the Power App
PORTAL_APP_CONTEXT=on        # Context inside the portal; requires KGE_URL
PORTAL_APP_DISCOVER=on       # Discover browsing, search and access requests
# Run Query on table pages and its server endpoint; on or off, default off; read at portal startup.
PORTAL_TABLE_QUERY=off
# Preview on table pages, its endpoints and CSV exports; on or off, default off; read at portal startup.
PORTAL_TABLE_PREVIEW=off
# Data quality filter buttons; on or off, default on. off shows All with no filter buttons.
PORTAL_DQ_FILTERS=on
PORTAL_CERTIFY_URL=          # external http or https address; empty shows [Power App link]

SUGGESTED_MENTION_MIN_SIMILARITY= # optional 0–1 override; blank: 0.55 for hash embeddings, 0.70 for real models
SUGGESTED_MENTION_CAP=20 # maximum suggested passage-to-term links per onboarding, highest similarity first; 0 disables

# Document reader: text (default, no model), or gemini (Vertex AI, the reader model and existing Vertex settings).
DOCUMENT_READER=text

# Durable Ask runs: store (shared bucket or local folder) or bigquery.
QUESTION_STATE_BACKEND=store
# Whole question lifetime, positive and below 1200 seconds (default 900).
QUESTION_RUN_TIMEOUT=900
# Interval a background question asks its client to poll at, and the least time between warehouse status reads after the
# first response, positive and below 60 seconds.
QUESTION_POLL_SECONDS=2
# How long a new question's first response waits for its warehouse work, 0 or more and below 60 seconds (default 5); a live
# (NDJSON) first response sends the run's id at once and its events as they come while it waits.
QUESTION_START_WAIT=5
